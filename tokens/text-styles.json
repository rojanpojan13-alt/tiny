{
  "Heading-Large": {
    "$value": {
      "fontFamily": "Inter",
      "fontWeight": "Bold",
      "fontSize": 32,
      "lineHeight": {
        "unit": "PIXELS",
        "value": 40
      },
      "letterSpacing": {
        "unit": "PERCENT",
        "value": -1
      },
      "textCase": "ORIGINAL",
      "textDecoration": "NONE"
    },
    "$type": "typography",
    "$description": "Page titles"
  },
  "Body": {
    "$value": {
      "fontFamily": "Inter",
      "fontWeight": "Regular",
      "fontSize": 16,
      "lineHeight": {
        "unit": "PIXELS",
        "value": 24
      },
      "letterSpacing": {
        "unit": "PERCENT",
        "value": 0
      },
      "textCase": "ORIGINAL",
      "textDecoration": "NONE"
    },
    "$type": "typography"
  },
  "Caption": {
    "$value": {
      "fontFamily": "Inter",
      "fontWeight": "Medium",
      "fontSize": 12,
      "lineHeight": {
        "unit": "AUTO"
      },
      "letterSpacing": {
        "unit": "PERCENT",
        "value": 2
      },
      "textCase": "UPPER",
      "textDecoration": "NONE"
    },
    "$type": "typography",
    "$extensions": {
      "com.example.build": {
        "cssClass": "caption"
      }
    }
  }
}